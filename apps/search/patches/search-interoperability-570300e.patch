+import { describe, expect, it } from 'vitest';
+import { sampleListings, fixtureTimestamp } from '../fixtures/index';
+import { valuate, type ComparableCandidate } from '../engine/valuation';
+import { ListingSchema, ValuationSchema } from './index';
+
+const subject = { ...sampleListings[1], bedrooms: 1, utilitiesIncluded: 'yes' as const };
+const now = new Date(fixtureTimestamp);
+const candidates: ComparableCandidate[] = Array.from({ length: 6 }, (_, i) => ({
+  ...subject, id: `10000000-0000-4000-8000-${String(i + 1).padStart(12, '0')}`,
+  monthlyRentCad: 2000 + i * 50, utilitiesIncluded: 'no',
+  distanceM: 500, lastSeenAt: fixtureTimestamp, duplicateOf: null, buildingKey: null,
+}));
+
+describe('C valuation contract', () => {
+  it('accepts C’s active torontorentals source without dropping provenance', () => {
+    expect(ListingSchema.parse({ ...subject, source: 'torontorentals' }).source).toBe('torontorentals');
+  });
+
+  it('accepts actual successful output and preserves adjustment evidence and absent benchmark', () => {
+    const value = valuate(subject, candidates, null, now);
+    expect(value.status).toBe('ok');
+    expect(value.adjustments[0]).toMatchObject({ code: 'utilitiesIncluded', count: 6 });
+    expect(ValuationSchema.parse(value)).toEqual(value);
+  });
+
+  it('preserves considered count for sparse and same-building insufficient pools', () => {
+    for (const pool of [candidates.slice(0, 3), candidates.map(c => ({ ...c, buildingKey: 'one-building' }))]) {
+      const value = valuate(subject, pool, null, now);
+      expect(value.status).toBe('insufficient_data');
+      expect(value.comparableCount).toBe(pool.length);
+      expect(value.comparables).toEqual([]);
+      expect(ValuationSchema.parse(value)).toEqual(value);
+      expect(ValuationSchema.safeParse({ ...value, estimatedRentCad: 2500 }).success).toBe(false);
+      expect(ValuationSchema.safeParse({ ...value, comparables: [candidates[0]] }).success).toBe(false);
+    }
+  });
+});
