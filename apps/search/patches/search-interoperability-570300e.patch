+
+const searchRequest = (intent: unknown) => new Request('http://localhost/api/listings/search', { method: 'POST', body: JSON.stringify({ intent }), headers: { 'Content-Type': 'application/json' } });
+
+test('ordinary and percentile API results preserve identity in the existing A store and detail API', async () => {
+  const api = createRuntime({ env: { SEARCH_FIXTURES: '1' } });
+  for (const intent of [baseIntent, { ...baseIntent, numericExtreme: { field: 'rent', direction: 'min', percentage: 5 } }]) {
+    const response = await api.search(searchRequest(intent), undefined);
+    assert.equal(response.status, 200);
+    const search = SearchResponseSchema.parse(await response.json());
+    assert.equal(search.status, 'completed');
+    if (search.status !== 'completed') throw Error('Expected completed fixture search');
+    assert.ok(search.results.length);
+    const results: SearchResultItem[] = search.results;
+    assert.ok(results.every(result => result.id === result.listing.id));
+    const store = createAppStore();
+    store.getState().receiveResults(store.getState().startSearch(), results);
+    store.getState().setHoveredListingId(results[0].id);
+    store.getState().setSelectedListingId(results[0].id);
+    store.getState().receiveResults(store.getState().startSearch(), results);
+    assert.equal(store.getState().hoveredListingId, results[0].listing.id);
+    assert.equal(store.getState().selectedListingId, results[0].listing.id);
+    const detailResponse = await api.detail(new Request(`http://localhost/api/listings/${results[0].id}?intent=${encodeURIComponent(JSON.stringify(baseIntent))}`), { params: Promise.resolve({ id: results[0].id }) });
+    assert.equal(detailResponse.status, 200);
+    const detail = DetailResponseSchema.parse(await detailResponse.json());
+    assert.equal(detail.id, results[0].id);
+    assert.equal(detail.id, detail.listing.id);
+    const mismatched = { ...results[0], id: sampleListings.find(listing => listing.id !== results[0].id)!.id };
+    assert.equal(SearchResponseSchema.safeParse({ ...search, results: [mismatched] }).success, false);
+    assert.equal(DetailResponseSchema.safeParse({ ...detail, id: mismatched.id }).success, false);
+    assert.equal(SearchResponseSchema.safeParse({ ...search, results: [{ ...results[0], id: undefined }] }).success, false);
+  }
+});
+
+test('API payload type exported for A matches errors returned by B', async () => {
+  const api = createRuntime({ env: {} });
+  const response = await api.search(searchRequest(baseIntent), undefined);
+  assert.equal(response.status, 503);
+  const error: ApiError = ErrorResponseSchema.parse(await response.json()).error;
+  const store = createAppStore();
+  store.getState().receiveError(store.getState().startSearch(), error);
+  assert.equal(store.getState().error?.code, 'service_unavailable');
+});
