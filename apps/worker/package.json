{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "start": "node --env-file-if-exists=../../.env.local src/index.ts",
    "ingest:once": "node --env-file-if-exists=../../.env.local src/ingest.ts",
    "browser:install": "cloakbrowser install",
    "load:cache": "node --env-file-if-exists=../../.env.local src/load-cache.ts",
    "dedupe:listings": "node --env-file-if-exists=../../.env.local src/dedupe.ts",
    "load:manual": "node --env-file-if-exists=../../.env.local src/load-manual.ts",
    "manual:candidates": "node --env-file-if-exists=../../.env.local src/manual-candidates.ts",
    "ai:backfill": "node --env-file-if-exists=../../.env.local src/ai-backfill.ts",
    "data:civic": "node --env-file-if-exists=../../.env.local src/civic/cli.ts",
    "load:benchmarks": "node --env-file-if-exists=../../.env.local src/load-benchmarks.ts"
  },
  "dependencies": {
    "@rentthe6ix/shared": "workspace:*",
    "cloakbrowser": "^0.6.3",
    "playwright-core": "^1.64.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
