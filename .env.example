# Copy to .env.local at the repo root (dev) or .env (Vultr instance). Never commit the filled-in copy.
# The app starts and is usable with AI_PROVIDER=none, no MapTiler key, and no OTP.

# --- AI (Gemini) ---------------------------------------------------------
AI_PROVIDER=gemini                 # gemini | none
GEMINI_API_KEY=
GEMINI_MODEL=                      # current Flash model from Google's model list
GEMINI_MODEL_FAST=                 # current Flash-Lite model

# --- Database (TigerData) -------------------------------------------------
DATABASE_URL=                      # postgres://…?sslmode=require

# --- Map & geocoding ------------------------------------------------------
NEXT_PUBLIC_MAPTILER_KEY=          # optional; OpenFreeMap basemap without it

# --- Travel times (OpenTripPlanner) --------------------------------------
OTP_URL=http://otp:8080            # http://localhost:8080 when running OTP locally
TRAVEL_PRECOMPUTE_RPS=20

# --- Listing worker -------------------------------------------------------
USER_AGENT="RentThe6ix hackathon bot (contact: team@example.com)"   # put a real contact email
INGEST_SOURCES=kijiji,rentals_ca,zillow,realtor_ca,manual          # only sources marked "go" in apps/worker/SOURCES.md
INGEST_INTERVAL_HOURS=6
INGEST_REQUEST_DELAY_MS=4000
